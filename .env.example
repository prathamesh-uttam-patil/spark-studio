# ============================================================
# SPARK STUDIO — ENVIRONMENT CONFIGURATION
# ============================================================

# Primary canonical origin URL (used for sitemap, canonical links, and OG cards)
NEXT_PUBLIC_SITE_URL=https://sparkstudio.design

# Optional: Privacy-preserving analytics (Google Analytics 4 or Plausible)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Email Service Integration (e.g. Resend) for /api/contact
# Uncomment and provide key when connected in production
# RESEND_API_KEY=re_1234567890abcdef

# Optional: SMTP Configuration (if using Nodemailer fallback)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=inquiries@sparkstudio.design
# SMTP_PASS=your-secure-password
